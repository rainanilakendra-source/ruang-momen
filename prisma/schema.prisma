// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String         @id @default(cuid())
  name            String
  email           String         @unique
  role            String         @default("USER")
  passwordHash    String?        @map("password_hash")
  imageUrl        String?        @map("image_url")
  emailVerifiedAt DateTime?      @map("email_verified_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  sessions        Session[]
  events          Event[]
  orders          Order[]
  subscriptions   Subscription[]
  oauthAccounts   OAuthAccount[]
  oauthFlows      OAuthFlow[]
  twoFactorEnabled         Boolean                   @default(false) @map("two_factor_enabled")
  twoFactorSecretEncrypted String?                   @map("two_factor_secret_encrypted")
  twoFactorRecoveryCodes   TwoFactorRecoveryCode[]
  twoFactorChallenges      TwoFactorChallenge[]

  @@map("users")
}

model TwoFactorRecoveryCode {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  codeHash  String    @unique @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("two_factor_recovery_codes")
}

model TwoFactorChallenge {
  id              String   @id @default(cuid())
  tokenHash       String   @unique @map("token_hash")
  userId          String   @map("user_id")
  portal          String
  type            String
  secretEncrypted String?  @map("secret_encrypted")
  attempts        Int      @default(0)
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("two_factor_challenges")
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  provider          String
  providerAccountId String   @map("provider_account_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
  @@map("oauth_accounts")
}

model OAuthFlow {
  id                 String   @id @default(cuid())
  stateHash          String   @unique @map("state_hash")
  browserBindingHash String   @map("browser_binding_hash")
  codeVerifier       String   @map("code_verifier")
  nonce              String
  portal             String
  intent             String
  userId             String?  @map("user_id")
  expiresAt          DateTime @map("expires_at")
  createdAt          DateTime @default(now()) @map("created_at")
  user               User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
  @@map("oauth_flows")
}

enum EventType {
  WEDDING
  BIRTHDAY
  GATHERING
  GRADUATION
  REUNION
  CORPORATE
  OTHER
}

model Event {
  id                   String    @id @default(cuid())
  ownerId              String    @map("owner_id")
  planId               String    @map("plan_id")
  name                 String
  slug                 String    @unique
  type                 EventType
  eventDate            DateTime  @map("event_date") @db.Date
  coverStorageKey      String?   @map("cover_storage_key")
  themeKey             String    @default("MIDNIGHT") @map("theme_key")
  frameKey             String    @default("NONE") @map("frame_key")
  guestUploadEnabled   Boolean   @default(true) @map("guest_upload_enabled")
  guestGalleryEnabled  Boolean   @default(false) @map("guest_gallery_enabled")
  guestDownloadEnabled Boolean   @default(false) @map("guest_download_enabled")
  uploadStartsAt       DateTime? @map("upload_starts_at")
  uploadEndsAt         DateTime? @map("upload_ends_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  owner  User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  plan   Plan    @relation(fields: [planId], references: [id], onDelete: Restrict)
  photos Photo[]
  reactions PhotoReaction[]
  guestbookEntries GuestbookEntry[]

  @@index([ownerId])
  @@index([planId])
  @@index([eventDate])
  @@map("events")
}

model Plan {
  id             String         @id @default(cuid())
  code           String         @unique
  name           String
  slug           String         @unique
  description    String?
  price          Int            @default(0)
  maxGuests      Int            @default(0) @map("max_guests")
  maxPhotos      Int            @default(0) @map("max_photos")
  storageLimitMb Int            @default(0) @map("storage_limit_mb")
  durationDays   Int            @default(0) @map("duration_days")
  active         Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  features       PlanFeature[]
  limit          PlanLimit?
  events         Event[]
  orders         Order[]
  subscriptions  Subscription[]

  @@map("plans")
}

model PlanFeature {
  id        String  @id @default(cuid())
  planId    String  @map("plan_id")
  featureId String  @map("feature_id")
  plan      Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature   Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId])
  @@index([featureId])
  @@map("plan_features")
}

model Feature {
  id          String        @id @default(cuid())
  name        String
  key         String        @unique
  description String?
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  plans       PlanFeature[]

  @@map("features")
}

model PlanLimit {
  id              String @id @default(cuid())
  planId          String @unique @map("plan_id")
  maxPhotos       Int    @map("max_photos")
  maxStorageBytes BigInt @map("max_storage_bytes")
  maxActiveDays   Int    @map("max_active_days")
  plan            Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("plan_limits")
}

model Photo {
  id             String   @id @default(cuid())
  eventId        String   @map("event_id")
  storageKey     String   @unique @map("storage_key")
  previewStorageKey String? @map("preview_storage_key")
  originalName   String   @map("original_name")
  mimeType       String   @map("mime_type")
  sizeBytes      Int      @map("size_bytes")
  source         String?  @map("source")
  guestName      String?  @map("guest_name")
  clientUploadId String?  @unique @map("client_upload_id")
  createdAt      DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reactions PhotoReaction[]

  @@index([eventId])
  @@map("photos")
}

model PhotoReaction {
  id              String   @id @default(cuid())
  photoId         String   @map("photo_id")
  eventId         String   @map("event_id")
  guestIdentifier String   @map("guest_identifier") @db.VarChar(64)
  createdAt       DateTime @default(now()) @map("created_at")

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([photoId, guestIdentifier])
  @@index([eventId])
  @@map("photo_reactions")
}

model GuestbookEntry {
  id              String   @id @default(cuid())
  eventId         String   @map("event_id")
  guestIdentifier String   @map("guest_identifier") @db.VarChar(64)
  guestName       String   @map("guest_name") @db.VarChar(80)
  message         String   @db.VarChar(500)
  createdAt       DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([eventId, guestIdentifier, createdAt])
  @@map("guestbook_entries")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PaymentMethod {
  id            String   @id @default(cuid())
  name          String
  type          String
  mode          String
  description   String?
  bankName      String?  @map("bank_name")
  accountName   String?  @map("account_name")
  accountNumber String?  @map("account_number")
  qrImageUrl    String?  @map("qr_image_url")
  provider      String?
  instructions  String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  orders        Order[]

  @@index([active])
  @@map("payment_methods")
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique @map("order_number")
  userId          String        @map("user_id")
  planId          String        @map("plan_id")
  amount          Int
  status          String        @default("PENDING")
  paymentMethodId String        @map("payment_method_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  user            User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan            Plan          @relation(fields: [planId], references: [id], onDelete: Restrict)
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  paymentProof    PaymentProof?
  subscription    Subscription?

  @@index([userId])
  @@index([planId])
  @@index([paymentMethodId])
  @@index([status])
  @@map("orders")
}

model PaymentProof {
  id         String   @id @default(cuid())
  orderId    String   @unique @map("order_id")
  fileUrl    String   @map("file_url")
  note       String?
  uploadedAt DateTime @default(now()) @map("uploaded_at")
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payment_proofs")
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  planId    String   @map("plan_id")
  orderId   String   @unique @map("order_id")
  status    String   @default("ACTIVE")
  startedAt DateTime @map("started_at")
  expiredAt DateTime @map("expired_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([userId, status, expiredAt])
  @@index([planId])
  @@map("subscriptions")
}
