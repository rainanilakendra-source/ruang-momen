// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  passwordHash    String?   @map("password_hash")
  imageUrl        String?   @map("image_url")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  sessions        Session[]
  events          Event[]

  @@map("users")
}

enum EventType {
  WEDDING
  BIRTHDAY
  GATHERING
  GRADUATION
  REUNION
  CORPORATE
  OTHER
}

model Event {
  id                   String    @id @default(cuid())
  ownerId              String    @map("owner_id")
  name                 String
  slug                 String    @unique
  type                 EventType
  eventDate            DateTime  @map("event_date") @db.Date
  coverStorageKey      String?   @map("cover_storage_key")
  guestUploadEnabled   Boolean   @default(true) @map("guest_upload_enabled")
  guestGalleryEnabled  Boolean   @default(false) @map("guest_gallery_enabled")
  guestDownloadEnabled Boolean   @default(false) @map("guest_download_enabled")
  uploadStartsAt       DateTime? @map("upload_starts_at")
  uploadEndsAt         DateTime? @map("upload_ends_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  owner  User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  photos Photo[]

  @@index([ownerId])
  @@index([eventDate])
  @@map("events")
}

model Photo {
  id             String   @id @default(cuid())
  eventId        String   @map("event_id")
  storageKey     String   @unique @map("storage_key")
  originalName   String   @map("original_name")
  mimeType       String   @map("mime_type")
  sizeBytes      Int      @map("size_bytes")
  source         String?  @map("source")
  guestName      String?  @map("guest_name")
  clientUploadId String?  @unique @map("client_upload_id")
  createdAt      DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("photos")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}
